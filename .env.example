# ─── Серверные секреты (НИКОГДА не добавлять NEXT_PUBLIC_) ───
# Эти переменные читаются только на сервере, в app/api/order/route.ts.
# В Vercel задать для Production / Preview / Development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Публичные контакты (инлайнятся в клиентский бандл) ───
# Если значение пустое — соответствующая кнопка/строка не выводится.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_TELEGRAM_USERNAME=
